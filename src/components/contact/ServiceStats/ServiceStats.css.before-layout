.service-stats{

    margin:50px 0;

}

.service-stats__header{

    text-align:center;

    margin-bottom:35px;

}

.service-stats__badge{

    display:inline-block;

    padding:8px 18px;

    border-radius:40px;

    background:#E8F1FA;

    color:#0B4F8A;

    font-weight:600;

    margin-bottom:15px;

}

.service-stats__header h2{

    margin-bottom:10px;

    color:#0B4F8A;

}

.service-stats__header p{

    color:#666;

}

.service-stats__summary{

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:20px;

    margin-bottom:35px;

}

.service-stats__card{

    background:#ffffff;

    border-radius:18px;

    padding:25px;

    text-align:center;

    box-shadow:0 8px 25px rgba(0,0,0,.08);

}

.service-stats__card h3{

    font-size:2rem;

    color:#0B4F8A;

    margin-bottom:10px;

}

.service-stats__card h4{

    margin-bottom:10px;

}

.service-stats__card p{

    color:#666;

    line-height:1.6;

}

.service-stats__analytics{

    display:grid;

    grid-template-columns:2fr 1fr;

    gap:25px;

}

.service-stats__chart{

    background:#fff;

    border-radius:18px;

    padding:25px;

    box-shadow:0 8px 25px rgba(0,0,0,.08);

}

.service-stats__chart-title{

    font-weight:700;

    color:#0B4F8A;

    margin-bottom:20px;

}

.service-stats__placeholder{

    height:260px;

    border:2px dashed #d7d7d7;

    display:flex;

    justify-content:center;

    align-items:center;

    border-radius:12px;

    color:#888;

}

@media(max-width:992px){

.service-stats__summary{

grid-template-columns:repeat(2,1fr);

}

.service-stats__analytics{

grid-template-columns:1fr;

}

}

@media(max-width:640px){

.service-stats__summary{

grid-template-columns:1fr;

}

}

.service-stats__summary{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:24px;
    margin-bottom:48px;
}

.service-stats__card{
    display:flex;
    align-items:flex-start;
    gap:18px;

    padding:24px;

    border-radius:18px;

    background:#ffffff;

    border:1px solid #e5e7eb;

    transition:
        transform .3s ease,
        box-shadow .3s ease,
        border-color .3s ease;
}

.service-stats__card:hover{

    transform:translateY(-6px);

    border-color:#0B4F8A;

    box-shadow:
        0 16px 40px rgba(11,79,138,.12);

}

.service-stats__icon{

    width:64px;

    height:64px;

    border-radius:18px;

    flex-shrink:0;

    display:flex;

    align-items:center;

    justify-content:center;

    background:#EAF4FF;

    font-size:30px;

}

.service-stats__content{

    flex:1;

}

.service-stats__content h3{

    margin:0;

    color:#0B4F8A;

    font-size:2rem;

    font-weight:700;

}

.service-stats__content h4{

    margin:8px 0;

    font-size:1.05rem;

    font-weight:600;

}

.service-stats__content p{

    margin:0;

    color:#6b7280;

    line-height:1.7;

}

/* ===========================
   CHART CONTAINER
=========================== */

.service-stats__chart-canvas{

    position:relative;

    width:100%;

    height:320px;

}

.service-stats__legend{

    margin-top:24px;

}

.service-stats__respondent{

    text-align:center;

    margin-bottom:20px;

}

.service-stats__respondent strong{

    display:block;

    font-size:1.6rem;

    color:#0B4F8A;

}

.service-stats__respondent span{

    color:#6b7280;

}

.service-stats__legend-item{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:10px 0;

    border-bottom:1px solid #eef2f7;

}

.service-stats__legend-left{

    display:flex;

    align-items:center;

    gap:10px;

}

.service-stats__dot{

    width:12px;

    height:12px;

    border-radius:50%;

}

.service-stats__legend-right{

    display:flex;

    gap:12px;

    align-items:center;

}

.service-stats__up{

    color:#16A34A;

    font-weight:600;

}

.service-stats__down{

    color:#DC2626;

    font-weight:600;

}