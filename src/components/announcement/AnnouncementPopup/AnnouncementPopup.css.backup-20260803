/* =========================================================
   ANNOUNCEMENT POPUP
   ========================================================= */

.announcement-popup {
    position: fixed;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;

    padding: 16px;

    background: rgba(0, 0, 0, 0.55);

    backdrop-filter: blur(5px);

    z-index: 99999;

    overflow: hidden;

    box-sizing: border-box;
}


/* =========================================================
   POPUP FRAME
   ========================================================= */

.announcement-popup__box {
    width: min(720px, 95vw);

    max-width: 720px;

    max-height: calc(100vh - 32px);

    background: transparent;

    border-radius: 22px;

    overflow: hidden;

    box-shadow:
        0 25px 70px rgba(0, 0, 0, 0.30);

    animation: popupShow 0.35s ease;

    box-sizing: border-box;
}


@keyframes popupShow {

    from {
        opacity: 0;
        transform: translateY(30px) scale(0.95);
    }

    to {
        opacity: 1;
        transform: none;
    }

}


/* =========================================================
   CONTENT
   ========================================================= */

.announcement-popup__content {

    width: 100%;

    max-height: calc(100vh - 32px);

    padding: 24px 32px 28px;

    background:
        rgba(255, 255, 255, 0.94);

    backdrop-filter:
        blur(12px);

    border-radius:
        22px;

    box-shadow:
        0 20px 50px rgba(0, 0, 0, 0.25);

    text-align: center;

    overflow-y: auto;
    overflow-x: hidden;

    box-sizing: border-box;

    scrollbar-width: thin;
}


/* =========================================================
   LOGO
   ========================================================= */

.announcement-popup__logo {

    width: 150px;

    max-width: 45%;

    max-height: 90px;

    display: block;

    margin: 0 auto 10px;

    object-fit: contain;
}


/* =========================================================
   TITLE
   ========================================================= */

.announcement-popup__title {

    text-align: center;

    font-size: 34px;

    line-height: 1.15;

    color: #0b3d6d;

    font-weight: 800;

    margin: 0;
}


/* =========================================================
   SUBTITLE
   ========================================================= */

.announcement-popup__subtitle {

    text-align: center;

    margin-top: 7px;

    margin-bottom: 20px;

    color: #667085;

    font-size: 18px;

    line-height: 1.4;

    font-weight: 500;
}


/* =========================================================
   CARD INFORMASI
   ========================================================= */

.announcement-popup__card {

    width: 100%;

    background:
        rgba(248, 250, 252, 0.95);

    border:
        1px solid #dbe4ef;

    border-radius: 18px;

    padding: 18px;

    margin-bottom: 18px;

    box-sizing: border-box;
}


/* =========================================================
   IMAGE PENGUMUMAN
   ========================================================= */

.announcement-popup__image {

    display: block;

    width: 100%;

    height: auto;

    max-height: 38vh;

    object-fit: contain;

    border-radius: 14px;

    margin: 0 auto 14px;
}


/* =========================================================
   CARD TITLE
   ========================================================= */

.announcement-popup__card h4 {

    font-size: 25px;

    color: #1e293b;

    margin: 0 0 10px;

    line-height: 1.25;

    font-weight: 800;
}


/* =========================================================
   CARD DESCRIPTION
   ========================================================= */

.announcement-popup__card p {

    color: #475467;

    line-height: 1.6;

    font-size: 16px;

    margin: 0;
}


/* =========================================================
   CHECKBOX
   ========================================================= */

.announcement-popup__checkbox {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    margin: 0 0 14px;

    font-size: 15px;

    line-height: 1.4;

    color: #344054;

    cursor: pointer;
}


.announcement-popup__checkbox input {

    width: 18px;

    height: 18px;

    flex: 0 0 auto;

    cursor: pointer;
}


/* =========================================================
   BUTTON
   ========================================================= */

.announcement-popup__button {

    display: block;

    width: 100%;

    min-height: 52px;

    border: none;

    border-radius: 14px;

    background: #ffc107;

    color: #111827;

    font-size: 18px;

    font-weight: 700;

    padding: 14px 18px;

    cursor: pointer;

    transition:
        background 0.25s ease,
        transform 0.25s ease;
}


.announcement-popup__button:hover {

    background: #ffb300;

    transform: translateY(-2px);
}


.announcement-popup__button:active {

    transform: translateY(0);
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 768px) {

    .announcement-popup {

        padding: 12px;

    }


    .announcement-popup__content {

        max-height: calc(100vh - 24px);

        padding: 20px 18px 22px;

    }


    .announcement-popup__logo {

        width: 120px;

        max-width: 40%;

        max-height: 70px;

        margin-bottom: 8px;

    }


    .announcement-popup__title {

        font-size: 28px;

    }


    .announcement-popup__subtitle {

        font-size: 16px;

        margin-top: 6px;

        margin-bottom: 16px;

    }


    .announcement-popup__card {

        padding: 14px;

        margin-bottom: 15px;

    }


    .announcement-popup__image {

        max-height: 32vh;

        margin-bottom: 12px;

    }


    .announcement-popup__card h4 {

        font-size: 22px;

        margin-bottom: 8px;

    }


    .announcement-popup__card p {

        font-size: 14px;

        line-height: 1.5;

    }


    .announcement-popup__checkbox {

        font-size: 14px;

        margin-bottom: 12px;

    }


    .announcement-popup__button {

        min-height: 48px;

        font-size: 17px;

        padding: 12px 15px;

    }

}


/* =========================================================
   MOBILE PENDEK / LAYAR LAPTOP DENGAN HEIGHT RENDAH
   ========================================================= */

@media (max-height: 750px) and (min-width: 769px) {

    .announcement-popup {

        padding: 10px;

    }


    .announcement-popup__content {

        max-height: calc(100vh - 20px);

        padding: 16px 24px 20px;

    }


    .announcement-popup__logo {

        width: 105px;

        max-height: 55px;

        margin-bottom: 5px;

    }


    .announcement-popup__title {

        font-size: 28px;

    }


    .announcement-popup__subtitle {

        font-size: 16px;

        margin-top: 5px;

        margin-bottom: 12px;

    }


    .announcement-popup__card {

        padding: 12px;

        margin-bottom: 12px;

    }


    .announcement-popup__image {

        max-height: 30vh;

        margin-bottom: 10px;

    }


    .announcement-popup__card h4 {

        font-size: 21px;

        margin-bottom: 6px;

    }


    .announcement-popup__card p {

        font-size: 14px;

        line-height: 1.4;

    }


    .announcement-popup__checkbox {

        margin-bottom: 10px;

    }


    .announcement-popup__button {

        min-height: 44px;

        padding: 10px 15px;

    }

}


/* =========================================================
   MOBILE PENDEK
   ========================================================= */

@media (max-width: 768px) and (max-height: 700px) {

    .announcement-popup__content {

        padding: 14px 14px 16px;

    }


    .announcement-popup__logo {

        width: 90px;

        max-height: 50px;

    }


    .announcement-popup__title {

        font-size: 24px;

    }


    .announcement-popup__subtitle {

        font-size: 14px;

        margin-bottom: 10px;

    }


    .announcement-popup__card {

        padding: 10px;

        margin-bottom: 10px;

    }


    .announcement-popup__image {

        max-height: 27vh;

    }


    .announcement-popup__card h4 {

        font-size: 19px;

    }


    .announcement-popup__card p {

        font-size: 13px;

    }


    .announcement-popup__checkbox {

        font-size: 13px;

        margin-bottom: 9px;

    }


    .announcement-popup__button {

        min-height: 42px;

        font-size: 16px;

        padding: 9px 12px;

    }

}